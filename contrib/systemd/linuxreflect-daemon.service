[Unit]
Description=LinuxReflect backup daemon
Requires=linuxreflect-daemon.socket
After=linuxreflect-daemon.socket

[Service]
Type=notify
ExecStart=/usr/local/bin/linuxreflect-daemon --socket /run/linuxreflect/daemon.sock --no-create-group
WatchdogSec=60
Restart=on-failure
RestartSec=2
# SIGTERM makes the daemon refuse new jobs and exit once the running ones are
# done (D-107): a stop, an update or a shutdown does not cut a restore in half.
# While jobs drain, the daemon extends this timeout only as long as one of them
# makes progress, and names the job it waits for (D-113); a job stuck in I/O
# therefore cannot hold a shutdown forever. A job can still be cancelled from
# the GUI or `linuxreflect job cancel`.
TimeoutStopSec=10min

[Install]
WantedBy=multi-user.target
