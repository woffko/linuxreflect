// LinuxReflect GUI (spec §K S15).
//
// Organised like Macrium Reflect: a navigation sidebar (Back up, Restore,
// Activity), every disk shown with its partition map and the actions that
// apply to it, wizards that list their steps and pick devices in place, and a
// job strip that stays visible on every page. Every action goes through the
// daemon; the GUI never opens a device (spec §B).
//
// This file is compiled with Slint under the Royalty-Free 2.0 licence; the
// attribution the licence asks for is shown in the navigation (see D-090).

import { ScrollView, ListView, Button, ComboBox, CheckBox, LineEdit, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DiskRow, HistoryRow, PartitionTile, DiskCard, JobStage, JobPresentation } from "types.slint";
import { NavItem, DiskPanel, StepList, Banner, PageHeader } from "widgets.slint";

export { DiskRow, HistoryRow, PartitionTile, DiskCard, JobStage, JobPresentation }
// Exported so tooling can render the dark scheme (examples/gallery.rs).
export { Palette }

export component MainWindow inherits Window {
    title: "LinuxReflect — backup and restore";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 360px;
    background: Theme.window;

    in-out property <string> status: "ready";
    in-out property <string> socket: "";
    in-out property <string> source: "";
    in-out property <string> destination: "";
    // Backup folders used recently, newest first (remembered per user).
    in-out property <[string]> recent-destinations: [];
    in-out property <string> backup-set: "default";
    in-out property <string> mode: "auto";
    in-out property <string> member-type: "full";
    in-out property <string> snapshot: "auto";
    in-out property <bool> allow-freeze: false;
    in-out property <bool> allow-inconsistent: false;
    in-out property <string> compress: "zstd:9";
    in-out property <string> bad-sector: "abort";
    in-out property <bool> encrypt: false;
    in-out property <string> passphrase-file: "";
    in-out property <string> plan: "(no plan yet)";
    in-out property <string> image: "";
    // What the chosen image is, in words (set, kind, date), when known.
    in-out property <string> image-detail: "";
    in-out property <string> target: "";
    in-out property <string> restore-passphrase-file: "";
    in-out property <string> restore-plan: "(no plan yet)";
    in-out property <string> restore-summary: "";
    in-out property <bool> show-restore-details: false;
    in-out property <string> token: "";
    in-out property <string> planned-image: "";
    in-out property <string> planned-target: "";
    in-out property <bool> restore-confirmed: false;
    out property <bool> restore-plan-current: root.token != "" && root.image == root.planned-image && root.target == root.planned-target;
    in-out property <string> phase: "idle";
    in-out property <string> job-id: "";
    in-out property <string> job-operation: "";
    in-out property <bool> has-job: false;
    in-out property <string> last-image: "";
    // True while an action runs; the automation script waits on it.
    in-out property <bool> busy: false;
    in-out property <float> progress: 0;
    in-out property <string> progress-text: "";
    in-out property <string> result-text: "";
    in-out property <bool> show-result-details: false;
    in-out property <JobPresentation> backup-job;
    in-out property <JobPresentation> restore-job;
    in-out property <JobPresentation> verify-job;
    in-out property <[DiskRow]> disks: [];
    in-out property <[DiskCard]> disk-cards: [];
    in-out property <bool> show-system-devices: false;
    in-out property <string> disk-status: "";
    // Set when loading the disk list failed; the page offers Retry.
    in-out property <bool> disk-error: false;
    in-out property <[HistoryRow]> history: [];
    // The disk row that contains the current source, or -1.
    in-out property <int> selected-disk: -1;
    // 0 back up (disks), 1 backup wizard, 2 restore wizard, 3 library, 4 activity.
    in-out property <int> current-tab: 0;
    in-out property <bool> choosing-restore-target: false;
    in-out property <int> backup-step: 0;
    in-out property <int> restore-step: 0;
    in-out property <bool> advanced-backup: false;
    in-out property <bool> show-source-details: false;
    in-out property <bool> source-is-folder: false;
    in-out property <bool> show-source-path: false;
    in-out property <bool> show-destination-text: false;

    // Below this width the navigation moves to a top bar and wizards drop
    // their step list, so 1024x768 at 200% still fits.
    out property <bool> narrow: root.width < 760px;
    // Below this width wizards show "Step n of 4" instead of the step list.
    out property <bool> compact: root.width < 1000px;

    // Actions; the Rust side binds them to the daemon.
    callback refresh-disks();
    callback refresh-history();
    callback probe-source();
    callback start-backup();
    callback prepare-restore();
    callback restore-inputs-changed();
    callback start-restore();
    callback cancel-job();
    callback check-job();
    callback pick-source-folder();
    callback pick-destination();
    callback pick-image();
    callback pick-passphrase();
    callback pick-restore-passphrase();
    callback pick-target-folder();
    callback disk-selected(int);
    callback history-selected(int);
    callback verify-image(int);
    callback use-last-image();
    callback show-backup-tab();
    callback show-restore-tab();

    // The running job is cancellable only while it streams.
    function cancel-enabled() -> bool {
        root.busy && root.has-job && root.job-id != ""
    }

    function job-terminal(stage: JobStage) -> bool {
        stage == JobStage.succeeded || stage == JobStage.failed || stage == JobStage.cancelled
    }

    function job-title(operation: string, stage: JobStage) -> string {
        operation + (stage == JobStage.starting ? " starting…"
            : stage == JobStage.running ? " in progress"
            : stage == JobStage.cancelling ? " — cancellation requested"
            : stage == JobStage.disconnected ? " — connection lost; check job status"
            : stage == JobStage.succeeded ? " completed"
            : stage == JobStage.failed ? " failed"
            : stage == JobStage.cancelled ? " cancelled" : " not started")
    }

    function go-backup() {
        root.choosing-restore-target = false;
        root.current-tab = root.busy && root.job-operation == "backup" ? 1 : 0;
    }

    function go-restore() {
        root.choosing-restore-target = false;
        root.current-tab = root.busy && root.job-operation == "restore" ? 2 : 3;
        if (root.history.length == 0 && root.destination != "" && !root.busy) {
            root.refresh-history();
        }
    }

    // Explicit geometry: the content adapts to the width (`narrow`), so the
    // window's size constraints must not in turn depend on the content.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        VerticalLayout {
            // ── Top navigation (narrow windows) ─────────────────────────────────
            if root.narrow: Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 4px;
                    NavItem { text: "Back up"; active: root.current-tab <= 1; clicked => { root.go-backup(); } }
                    NavItem { text: "Restore"; active: root.current-tab == 2 || root.current-tab == 3; clicked => { root.go-restore(); } }
                    NavItem { text: "Activity"; active: root.current-tab == 4; clicked => { root.current-tab = 4; } }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                // ── Sidebar ─────────────────────────────────────────────────────
                if !root.narrow: Rectangle {
                    width: 210px;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "LinuxReflect";
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "Backup and restore";
                            color: Theme.muted;
                        }
                        Rectangle { height: 12px; }
                        NavItem { text: "Back up"; active: root.current-tab <= 1; clicked => { root.go-backup(); } }
                        NavItem { text: "Restore"; active: root.current-tab == 2 || root.current-tab == 3; clicked => { root.go-restore(); } }
                        NavItem { text: "Activity"; active: root.current-tab == 4; clicked => { root.current-tab = 4; } }
                        Rectangle { vertical-stretch: 1; }
                        // Slint Royalty-Free 2.0 asks for attribution; this provides it.
                        Text {
                            text: "Built with Slint (slint.dev) under the Slint Royalty-Free 2.0 licence.";
                            font-size: 11px;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // ── Pages ───────────────────────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    padding: root.narrow ? 10px : Theme.page-padding;
                    spacing: 10px;

                    // Back up: every disk with its map and actions.
                    if root.current-tab == 0: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            PageHeader {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                title: "Back up";
                                subtitle: "Choose a disk or a partition to image, or back up a folder.";
                            }
                            VerticalLayout {
                                alignment: start;
                                Button {
                                    text: "Back up a folder…";
                                    enabled: !root.busy;
                                    clicked => { root.source-is-folder = true; root.show-backup-tab(); root.pick-source-folder(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Refresh";
                                enabled: !root.busy;
                                clicked => { root.refresh-disks(); }
                            }
                            CheckBox {
                                text: "Show service devices";
                                checked: root.show-system-devices;
                                enabled: !root.busy;
                                toggled => { root.show-system-devices = self.checked; root.refresh-disks(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.disk-status != "": Banner {
                            text: root.disk-status;
                            error: root.disk-error;
                            action: root.disk-error ? "Retry" : "";
                            act => { root.refresh-disks(); }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 0px;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 14px;
                                alignment: start;
                                for card in root.disk-cards: DiskPanel {
                                    card: card;
                                    mode: 0;
                                    selected: root.source;
                                    enabled: !root.busy;
                                    disk-path: root.disks[card.disk-index].path;
                                    partition-selected: root.selected-disk == card.disk-index && root.source != root.disks[card.disk-index].path;
                                    select(row) => { root.disk-selected(row); }
                                    image-disk => {
                                        root.disk-selected(card.disk-index);
                                        root.backup-step = 0;
                                        root.show-backup-tab();
                                    }
                                    image-selection => { root.backup-step = 0; root.show-backup-tab(); }
                                }
                            }
                        }
                    }

                    // Backup wizard.
                    if root.current-tab == 1: HorizontalLayout {
                        spacing: 16px;
                        if !root.compact: StepList {
                            width: 170px;
                            steps: ["Source", "Destination", "Summary", "Progress"];
                            current: root.backup-step;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 10px;
                            PageHeader {
                                title: root.backup-step == 0 ? "What would you like to back up?"
                                    : root.backup-step == 1 ? "Where should the backup be saved?"
                                    : root.backup-step == 2 ? "Review your backup"
                                    : root.job-title("Backup", root.backup-job.stage);
                                subtitle: root.compact ? "Step " + (root.backup-step + 1) + " of 4" : "";
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                min-height: 0px;
                                VerticalLayout {
                                    spacing: 10px;
                                    padding-right: 14px;
                                    alignment: start;

                                    if root.backup-step == 0: VerticalLayout {
                                        spacing: 10px;
                                        Banner {
                                            text: root.source == "" ? "Nothing selected yet. Click a disk or a partition below, or choose a folder."
                                                : "Selected: " + root.source + ". The source is only read during the backup.";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Choose a folder…";
                                                enabled: !root.busy;
                                                clicked => { root.source-is-folder = true; root.pick-source-folder(); }
                                            }
                                            Button {
                                                text: "Refresh disks";
                                                enabled: !root.busy;
                                                clicked => { root.refresh-disks(); }
                                            }
                                        }
                                        for card in root.disk-cards: DiskPanel {
                                            card: card;
                                            mode: 1;
                                            selected: root.source;
                                            enabled: !root.busy;
                                            disk-path: root.disks[card.disk-index].path;
                                            select(row) => { root.source-is-folder = false; root.disk-selected(row); }
                                        }
                                        CheckBox { text: "Enter a path instead"; checked <=> root.show-source-path; }
                                        if root.show-source-path: LineEdit {
                                            text <=> root.source;
                                            placeholder-text: "/dev/sdX, /dev/mapper/… or a folder";
                                        }
                                    }

                                    if root.backup-step == 1: VerticalLayout {
                                        spacing: 10px;
                                        Text { text: "Backup folder"; font-weight: 700; color: Theme.text; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.destination == "" ? "No folder chosen" : root.destination;
                                                color: root.destination == "" ? Theme.muted : Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }
                                            Button { text: "Choose folder…"; enabled: !root.busy; clicked => { root.pick-destination(); } }
                                        }
                                        if root.recent-destinations.length > 0: Text { text: "Recently used"; color: Theme.muted; }
                                        for recent in root.recent-destinations: HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: recent;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }
                                            Button {
                                                text: root.destination == recent ? "In use" : "Use";
                                                enabled: !root.busy && root.destination != recent;
                                                accessible-label: "Use the backup folder " + recent;
                                                clicked => { root.destination = recent; }
                                            }
                                        }
                                        Text { text: "Backup name"; font-weight: 700; color: Theme.text; }
                                        LineEdit { text <=> root.backup-set; placeholder-text: "A name for this backup, for example laptop-root"; }
                                        Text {
                                            text: "Later backups with the same name in the same folder are kept together as one history.";
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                        }
                                        CheckBox { text: "Backup options"; checked <=> root.advanced-backup; }
                                        if !root.advanced-backup: Text {
                                            text: "Defaults: a full backup, the safest available consistency method, Zstandard compression, no encryption.";
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                        }
                                        if root.advanced-backup: VerticalLayout {
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Backup type"; vertical-alignment: center; width: 130px; color: Theme.text; }
                                                ComboBox { max-width: 320px; model: ["full", "incremental", "differential"]; current-value <=> root.member-type; }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Method"; vertical-alignment: center; width: 130px; color: Theme.text; }
                                                ComboBox { max-width: 320px; model: ["auto", "block", "stream", "file"]; current-value <=> root.mode; }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Consistency"; vertical-alignment: center; width: 130px; color: Theme.text; }
                                                ComboBox { max-width: 320px; model: ["auto", "offline", "btrfs", "lvm", "freeze", "none"]; current-value <=> root.snapshot; }
                                            }
                                            if root.snapshot == "freeze": CheckBox {
                                                text: "Allow a temporary filesystem freeze (applications may pause)";
                                                checked <=> root.allow-freeze;
                                            }
                                            if root.snapshot == "none": CheckBox {
                                                text: "Allow a copy that may be inconsistent (files can change during the backup)";
                                                checked <=> root.allow-inconsistent;
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Compression"; vertical-alignment: center; width: 130px; color: Theme.text; }
                                                ComboBox { max-width: 320px; model: ["zstd:9", "zstd:3", "none"]; current-value <=> root.compress; }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Bad sectors"; vertical-alignment: center; width: 130px; color: Theme.text; }
                                                ComboBox { max-width: 320px; model: ["abort", "record"]; current-value <=> root.bad-sector; }
                                            }
                                            CheckBox { text: "Encrypt with a passphrase file"; checked <=> root.encrypt; }
                                            if root.encrypt: HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: root.passphrase-file == "" ? "No passphrase file chosen" : root.passphrase-file;
                                                    color: root.passphrase-file == "" ? Theme.warning : Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                }
                                                Button { text: "Choose file…"; clicked => { root.pick-passphrase(); } }
                                            }
                                        }
                                        CheckBox { text: "Enter the destination as text (SFTP)"; checked <=> root.show-destination-text; }
                                        if root.show-destination-text: LineEdit {
                                            text <=> root.destination;
                                            placeholder-text: "/mnt/backups or sftp://user@host/path";
                                        }
                                    }

                                    if root.backup-step == 2: VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Back up: " + root.source; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                        Text { text: "Save to: " + root.destination; color: Theme.text; wrap: word-wrap; }
                                        Text { text: "Backup name: " + root.backup-set; color: Theme.text; wrap: word-wrap; }
                                        Text { text: "Type: " + root.member-type + " · Compression: " + root.compress + " · Encryption: " + (root.encrypt ? "on" : "off"); color: Theme.text; wrap: word-wrap; }
                                        Text {
                                            text: root.snapshot == "freeze" ? "A temporary filesystem freeze was allowed. Applications may pause."
                                                : root.snapshot == "none" ? "Live copy without a snapshot: the backup may be inconsistent."
                                                : "The daemon checks the consistency method again when the backup starts.";
                                            color: root.snapshot == "none" ? Theme.warning : Theme.muted;
                                            wrap: word-wrap;
                                        }
                                        CheckBox { text: "Technical plan"; checked <=> root.show-source-details; }
                                        if root.show-source-details: Text { text: root.plan; color: Theme.text; wrap: word-wrap; }
                                    }

                                    if root.backup-step == 3: VerticalLayout {
                                        spacing: 6px;
                                        if !root.job-terminal(root.backup-job.stage): Text {
                                            text: root.job-operation == "backup" && root.has-job ? Math.round(root.progress * 100) + "%" : "";
                                            font-size: 32px;
                                            font-weight: 700;
                                            color: Theme.text;
                                        }
                                        if !root.job-terminal(root.backup-job.stage): ProgressIndicator {
                                            progress: root.job-operation == "backup" && root.has-job ? root.progress : 0;
                                        }
                                        if root.job-operation == "backup" && root.progress-text != "": Text {
                                            text: root.progress-text;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.backup-job.detail;
                                            color: root.backup-job.stage == JobStage.failed ? Theme.danger
                                                : root.backup-job.stage == JobStage.succeeded ? Theme.success : Theme.text;
                                            wrap: word-wrap;
                                        }
                                        if root.backup-job.report != "": CheckBox { text: "Technical report"; checked <=> root.show-result-details; }
                                        if root.backup-job.report != "" && root.show-result-details: Text { text: root.backup-job.report; color: Theme.text; wrap: word-wrap; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.backup-step == 3 ? "Change settings" : "Back";
                                    enabled: root.backup-step > 0 && !root.busy;
                                    // A completed attempt has consumed its review; retry must probe again.
                                    clicked => { root.backup-step = root.backup-step == 3 ? 1 : root.backup-step - 1; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if root.backup-step == 0: Button {
                                    text: "Next";
                                    primary: true;
                                    enabled: root.source != "" && !root.busy;
                                    clicked => { root.backup-step = 1; }
                                }
                                if root.backup-step == 1: Button {
                                    text: "Next";
                                    primary: true;
                                    enabled: root.destination != "" && root.backup-set != "" && (!root.encrypt || root.passphrase-file != "")
                                        && (root.snapshot != "freeze" || root.allow-freeze)
                                        && (root.snapshot != "none" || root.allow-inconsistent) && !root.busy;
                                    clicked => { root.probe-source(); }
                                }
                                if root.backup-step == 2: Button {
                                    text: "Create backup";
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => { root.start-backup(); }
                                }
                                if root.backup-step == 3 && root.job-operation == "backup" && root.has-job && !root.job-terminal(root.backup-job.stage): Button {
                                    text: "Cancel backup";
                                    enabled: root.cancel-enabled();
                                    clicked => { root.cancel-job(); }
                                }
                                if root.backup-step == 3 && root.job-terminal(root.backup-job.stage): Button {
                                    text: "Done";
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => { root.current-tab = 0; root.backup-step = 0; }
                                }
                                if root.backup-step < 3: Button {
                                    text: "Cancel";
                                    enabled: !root.busy;
                                    clicked => { root.current-tab = 0; root.backup-step = 0; }
                                }
                            }
                        }
                    }

                    // Restore wizard.
                    if root.current-tab == 2: HorizontalLayout {
                        spacing: 16px;
                        if !root.compact: StepList {
                            width: 170px;
                            steps: ["Backup", "Destination", "Summary", "Progress"];
                            current: root.restore-step;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 10px;
                            PageHeader {
                                title: root.restore-step == 0 ? "Which backup do you want to restore?"
                                    : root.restore-step == 1 ? "Where should it be restored?"
                                    : root.restore-step == 2 ? "Review and confirm"
                                    : root.job-title("Restore", root.restore-job.stage);
                                subtitle: root.compact ? "Step " + (root.restore-step + 1) + " of 4" : "";
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                min-height: 0px;
                                VerticalLayout {
                                    spacing: 10px;
                                    padding-right: 14px;
                                    alignment: start;

                                    if root.restore-step == 0: VerticalLayout {
                                        spacing: 10px;
                                        Banner {
                                            text: root.image == "" ? "No backup chosen. Pick one from your backups or open an image file."
                                                : root.image-detail != "" ? root.image-detail + "\n" + root.image
                                                : "Backup: " + root.image;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button { text: "My backups…"; enabled: !root.busy; clicked => { root.go-restore(); root.current-tab = 3; } }
                                            Button { text: "Open image file…"; enabled: !root.busy; clicked => { root.pick-image(); } }
                                            Button {
                                                text: "Use the last backup";
                                                enabled: root.last-image != "" && !root.busy;
                                                clicked => { root.use-last-image(); }
                                            }
                                        }
                                        Text { text: "Passphrase file"; font-weight: 700; color: Theme.text; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: root.restore-passphrase-file == "" ? "Not needed for an unencrypted backup" : root.restore-passphrase-file;
                                                color: root.restore-passphrase-file == "" ? Theme.muted : Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                            }
                                            Button { text: "Choose file…"; enabled: !root.busy; clicked => { root.pick-restore-passphrase(); } }
                                        }
                                    }

                                    if root.restore-step == 1: VerticalLayout {
                                        spacing: 10px;
                                        Banner {
                                            text: root.target == "" ? "A disk image is restored to a disk or a partition; a file backup to a folder."
                                                : "Destination: " + root.target;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Restore files to a folder…";
                                                enabled: !root.busy;
                                                clicked => { root.pick-target-folder(); }
                                            }
                                            Button {
                                                text: "Refresh disks";
                                                enabled: !root.busy;
                                                clicked => { root.choosing-restore-target = true; root.refresh-disks(); }
                                            }
                                        }
                                        for card in root.disk-cards: DiskPanel {
                                            card: card;
                                            mode: 2;
                                            selected: root.target;
                                            enabled: !root.busy;
                                            disk-path: root.disks[card.disk-index].path;
                                            disk-unavailable: root.disks[card.disk-index].restore-unavailable;
                                            select(row) => { root.choosing-restore-target = true; root.disk-selected(row); }
                                        }
                                    }

                                    if root.restore-step == 2: VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Restore: " + root.planned-image; color: Theme.text; wrap: word-wrap; }
                                        Text { text: "Write to: " + root.planned-target; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                        Banner {
                                            error: true;
                                            text: "Everything currently on " + root.planned-target + " will be replaced. Check the destination before you confirm.";
                                        }
                                        Text { text: root.restore-summary; color: Theme.text; wrap: word-wrap; }
                                        CheckBox { text: "Technical plan"; checked <=> root.show-restore-details; }
                                        if root.show-restore-details: Text { text: root.restore-plan; color: Theme.text; wrap: word-wrap; }
                                    }

                                    if root.restore-step == 3: VerticalLayout {
                                        spacing: 6px;
                                        if !root.job-terminal(root.restore-job.stage): Text {
                                            text: root.job-operation == "restore" && root.has-job ? Math.round(root.progress * 100) + "%" : "";
                                            font-size: 32px;
                                            font-weight: 700;
                                            color: Theme.text;
                                        }
                                        if !root.job-terminal(root.restore-job.stage): ProgressIndicator {
                                            progress: root.job-operation == "restore" && root.has-job ? root.progress : 0;
                                        }
                                        if root.job-operation == "restore" && root.progress-text != "": Text {
                                            text: root.progress-text;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.restore-job.detail;
                                            color: root.restore-job.stage == JobStage.failed ? Theme.danger
                                                : root.restore-job.stage == JobStage.succeeded ? Theme.success : Theme.text;
                                            wrap: word-wrap;
                                        }
                                        if root.restore-job.report != "": CheckBox { text: "Technical report"; checked <=> root.show-result-details; }
                                        if root.restore-job.report != "" && root.show-result-details: Text { text: root.restore-job.report; color: Theme.text; wrap: word-wrap; }
                                    }
                                }
                            }
                            if root.restore-step == 2: CheckBox {
                                text: "I understand that the destination will be overwritten";
                                checked <=> root.restore-confirmed;
                                enabled: root.restore-plan-current && !root.busy;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Back";
                                    enabled: root.restore-step > 0 && !root.busy;
                                    clicked => {
                                        root.restore-step = root.restore-step == 3 ? 1 : root.restore-step - 1;
                                        root.restore-inputs-changed();
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if root.restore-step == 0: Button {
                                    text: "Next";
                                    primary: true;
                                    enabled: root.image != "" && !root.busy;
                                    clicked => { root.restore-step = 1; root.choosing-restore-target = true; if (root.disk-cards.length == 0) { root.refresh-disks(); } }
                                }
                                if root.restore-step == 1: Button {
                                    text: "Next";
                                    primary: true;
                                    enabled: !root.busy && root.image != "" && root.target != "";
                                    clicked => { root.choosing-restore-target = false; root.prepare-restore(); }
                                }
                                if root.restore-step == 2: Button {
                                    text: "Restore now";
                                    primary: true;
                                    enabled: root.restore-plan-current && root.restore-confirmed && !root.busy;
                                    clicked => { root.start-restore(); }
                                }
                                if root.restore-step == 3 && root.job-operation == "restore" && root.has-job && !root.job-terminal(root.restore-job.stage): Button {
                                    text: "Cancel restore";
                                    enabled: root.cancel-enabled();
                                    clicked => { root.cancel-job(); }
                                }
                                if root.restore-step == 3 && root.job-terminal(root.restore-job.stage): Button {
                                    text: "Done";
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => { root.current-tab = 3; root.restore-step = 0; root.restore-inputs-changed(); }
                                }
                                if root.restore-step < 3: Button {
                                    text: "Cancel";
                                    enabled: !root.busy;
                                    clicked => { root.choosing-restore-target = false; root.current-tab = 3; root.restore-step = 0; root.restore-inputs-changed(); }
                                }
                            }
                        }
                    }

                    // Restore: the backup library.
                    if root.current-tab == 3: VerticalLayout {
                        spacing: 10px;
                        PageHeader {
                            title: "Restore";
                            subtitle: "Every backup in the chosen folder, newest first. Choose one to restore.";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.destination == "" ? "No backup folder chosen" : root.destination;
                                color: root.destination == "" ? Theme.muted : Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                            Button {
                                text: "Choose folder…";
                                enabled: !root.busy;
                                clicked => { root.pick-destination(); }
                            }
                            Button {
                                text: "Refresh";
                                enabled: root.destination != "" && !root.busy;
                                clicked => { root.refresh-history(); }
                            }
                        }
                        if root.history.length == 0: Banner {
                            text: root.destination == "" ? "Choose the folder your backups are saved in."
                                : "No backups found in this folder yet. Refresh, choose another folder, or open an image file.";
                            action: "Open image file…";
                            act => { root.restore-step = 0; root.current-tab = 2; root.pick-image(); }
                        }
                        ListView {
                            vertical-stretch: 1;
                            min-height: 0px;
                            for row[idx] in root.history: VerticalLayout {
                                if row.first: Text {
                                    text: row.group;
                                    font-size: Theme.heading-size;
                                    font-weight: 700;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Rectangle {
                                    height: history-row.preferred-height;
                                    background: Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.card-border;
                                    border-radius: Theme.radius;
                                    history-row := HorizontalLayout {
                                        padding: 8px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            Text { text: row.name; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                            Text { text: row.detail; color: Theme.muted; wrap: word-wrap; }
                                        }
                                        Button {
                                            text: "Restore…";
                                            accessible-label: "Restore " + row.group + ", " + row.name;
                                            enabled: !root.busy;
                                            clicked => { root.history-selected(idx); }
                                        }
                                    }
                                }
                                Rectangle { height: 6px; }
                            }
                        }
                    }

                    // Activity: the jobs of this session.
                    if root.current-tab == 4: VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        PageHeader {
                            title: "Activity";
                            subtitle: "The backup and restore jobs started in this window.";
                        }
                        if root.backup-job.stage == JobStage.idle && root.restore-job.stage == JobStage.idle && root.verify-job.stage == JobStage.idle: Banner {
                            text: "No jobs yet.";
                        }
                        if root.backup-job.stage != JobStage.idle: Banner {
                            text: root.job-title("Backup", root.backup-job.stage) + "\n" + root.backup-job.detail;
                            error: root.backup-job.stage == JobStage.failed;
                            action: "Open";
                            act => { root.current-tab = 1; root.backup-step = 3; }
                        }
                        if root.verify-job.stage != JobStage.idle: Banner {
                            text: root.job-title("Verification", root.verify-job.stage) + "\n" + root.verify-job.detail;
                            error: root.verify-job.stage == JobStage.failed;
                        }
                        if root.restore-job.stage != JobStage.idle: Banner {
                            text: root.job-title("Restore", root.restore-job.stage) + "\n" + root.restore-job.detail;
                            error: root.restore-job.stage == JobStage.failed;
                            action: "Open";
                            act => { root.current-tab = 2; root.restore-step = 3; }
                        }
                    }
                }
            }

            // ── Job strip: visible on every page while a job exists ────────────
            if root.has-job || root.busy: Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    spacing: 10px;
                    Text {
                        text: root.has-job ? (root.job-operation == "restore" ? "Restore" : root.job-operation == "verify" ? "Verify" : "Backup") : root.phase;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        width: 70px;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 60px;
                        ProgressIndicator {
                            progress: root.has-job ? root.progress : 0;
                            indeterminate: root.busy && !root.has-job;
                        }
                    }
                    if root.has-job: Text {
                        text: Math.round(root.progress * 100) + "%";
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.has-job: Button { text: "Status"; clicked => { root.check-job(); } }
                    if root.has-job: Button { text: "Cancel job"; enabled: root.cancel-enabled(); clicked => { root.cancel-job(); } }
                }
            }

            // ── Status line ────────────────────────────────────────────────────
            Rectangle {
                background: Theme.sidebar;
                HorizontalLayout {
                    padding: 6px;
                    padding-left: 12px;
                    spacing: 8px;
                    Text {
                        text: root.status;
                        color: Theme.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    if root.narrow: Text {
                        text: "Built with Slint (Royalty-Free 2.0)";
                        font-size: 11px;
                        color: Theme.muted;
                    }
                }
            }
        }
    }
}
